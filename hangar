${C_B}hangar${C_0} v$VERSION — 一整隊 Android 測試機的停放、維護與調度

用法：
  hangar [-p 手機] [--hq|--lq] [--screen-on] [-- <scrcpy 參數…>]
                                   投影（預設指令）
  hangar all [--hq|--lq] [--screen-on]
                                   同時投影所有已設定的手機（各開一個視窗）
  hangar setup [手機的 IP] [--name 別名]
                                   初始化一支手機（需同區網或插 USB）
  hangar setup --transport tailscale [節點名] [--name 別名]
                                   同上，但改走 Tailscale（手機要拿去別的網路時）
  hangar setup --existing [IP 或節點名] [--name 別名]
                                   手機已由別台電腦設定好，只在這台建立設定
  hangar list                     列出已設定的手機與即時狀態（含電量）
  hangar list --json [--probe]    同上，輸出 JSON（--probe 連路徑/機型/電量一起取，比較慢）
                                  --probe 只對 --json 有作用，人類版表格欄位是固定的
  hangar scan [--subnet 192.168.1] [--no-ping] [--no-probe]
                                   掃描區網，列出看得到的裝置（不限已設定的）
                                   --subnet 可給好幾次；不在這台網段上的會逐台
                                   探 5555/5599（跨網段，沒有 MAC）
  hangar scan --fix-ip            順便把「認得出是同一支手機、但 profile 指著
                                   舊 IP」的那幾支修好
  hangar scan --json              同上，輸出 JSON
  hangar usb [--json]             這台電腦上 USB 接著的裝置（含未授權的）
  hangar enroll [-p 手機] [--apk <檔>]
                                   用 USB 或網路 ADB 在這支手機上裝 agent
  hangar enroll [-p 手機] --reinstall
                                   更新舊版 agent，只換新版 APK，token
                                   與入伍狀態都留著，其他電腦不會被踢掉
  hangar enroll [-p 手機] --takeover [--yes]
                                   手機已入伍、但這台電腦沒有它的 token 時，
                                   清掉手機上的入伍狀態再重新入伍一次
                                   （其他電腦手上的 token 會一起失效）
  hangar enroll [-p 手機] --hub http://<hub>:8789 | --no-hub
                                   讓 agent 主動回報給 hub（跨網段用；hub 要帶
                                   --checkin）。已入伍的手機只改這一項
  hangar ring [-p 手機] [--seconds 秒]
                                   讓已入伍的手機響鈴識別（0 或 --stop = 停）
  hangar adb [-p 手機] --on|--off
                                   開／關偵錯；全手動，不會自己變回去
  hangar wall [--bind 0.0.0.0] [--no-helper]
                                   開裝置牆：hub 與這台電腦的 helper 一起起來，
                                   同一台機器上不用再開那個帶鑰匙的連結
  hangar wall --checkin 0.0.0.0:8789
                                   另外開一個埠收手機的主動回報（跨網段用）
  hangar use <手機>               設定預設手機
  hangar forget <手機>            刪掉該手機的設定
  hangar status [-p 手機]         Tailscale / adb / 裝置狀態
  hangar status --json            同上，輸出 JSON
  hangar reset  [-p 手機]         連線卡死時重建 adb 連線
  hangar help                     這份說明（-h / --help 也可以）
  hangar --version                印出版本（-V 也可以）

  指令別名：status=st　list=ls　forget=rm
  adb 也可寫成 debug；--off 之後就一直關著，要開回來得有人按 --on（沒有自動復原）。
  -p 的名稱支援唯一前綴（-p wo 等同 -p work）。

連線方式：
  預設是同一個區網直連（TRANSPORT=lan），只要 adb / scrcpy / nc。
  手機要拿去別的網段、4G/5G 或 NAT 後面才需要 Tailscale：

    hangar setup --transport tailscale --name work

多台手機：
  每支手機一份 profile，放在 $PROFILE_DIR/<名稱>.conf。
  名稱預設取自位址（走 Tailscale 時取節點名），可用 --name 自訂：

    hangar setup --name work          # 公司機
    hangar setup --name test          # 測試機
    hangar -p work                    # 投影公司機
    hangar use work                   # 設為預設，之後直接打 hangar
    hangar all                        # 兩支一起開

  只設定一支時不用加 -p；設定多支又沒指定預設時會列出來讓你選。
  視窗標題預設是 profile 名稱，方便分辨。

多台電腦：
  手機的 5555 一旦開著，其他電腦不需要 USB 也不用再跑 adb tcpip：

    hangar setup --existing pixel-4    # 在第二台電腦上
    （手機會跳出授權對話框，按「一律允許」後再跑一次）

  ACL 記得把新電腦也加進 src。手機重開機後，要由接得到 USB／同區網的
  那台電腦重跑一次完整的 hangar setup，其他電腦就會自動恢復。

選項（投影用，hangar / hangar all 共用）：
  --hq          強制高畫質（1280 / 8M / 60fps）
  --lq          強制低頻寬（1024 / 3M / 30fps / h265）
  --screen-on   不要關掉手機自己的螢幕（預設會關）
  --            之後的參數原封不動傳給 scrcpy，例如：
                hangar -p work -- --window-x=100

預設會帶 --turn-screen-off：投影時手機自己的螢幕是黑的（省電、也不會被旁邊
的人看到），畫面只出現在電腦上。手機並沒有鎖住，仍然可以從電腦端操作。
scrcpy 關掉後螢幕會維持關著，按一下手機電源鍵就回來。

結束投影：scrcpy 視窗關掉就好（前景執行時 Ctrl-C 也可以）。
      hangar all 開的是背景視窗，要一次收掉：pkill -f 'scrcpy .*:${ADB_PORT}'

限制：手機重開機後 adb 的 ${ADB_PORT} 埠會消失（非 root 無法持久化），
      必須把那支手機接回 USB 或回到同一區網重跑一次 \`hangar setup\`。
EOF
}

# hangar usb — 這台電腦上 USB 接著的裝置
#
# 裝置牆的第三個資料來源。前兩個都看不到「插著 USB、偵錯開了、但還沒 setup」
# 的手機：`list` 只走 profile，`scan` 探的是 TCP 5555 —— 而 5555 要
# `adb tcpip` 才會開。**授權的是 USB 那把金鑰，跟 5555 是兩件不相干的事**，
# 所以那種手機在牆上會是一列匿名的 IP，跟隔壁的智慧插座長得一模一樣。
#
# `unauthorized` 是這裡最值錢的一格：「有人插了手機但沒人去按那個允許」
# 在這個指令出現以前是查不出來的。
#
# 刻意**不**塞進 `scan --json` 的 hosts[]：那一層的語意是「這個網段上有什麼」，
# 每一筆都有 IP 跟 MAC，USB 裝置兩個都沒有。獨立的 schema 比較誠實。
cmd_usb() {
  JSON_MODE=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) JSON_MODE=1; shift ;;
      *)      die "usb 不認得參數：$1" ;;
    esac
  done

  # 這個指令只需要 adb —— 不像投影還要 scrcpy。hub 那台常駐機器上沒裝 scrcpy
  # 也該問得出「插了什麼」，跟 cmd_scan 不走 require_deps 是同一個理由。
  if ! command -v adb >/dev/null 2>&1; then
    if [ "$JSON_MODE" -eq 1 ]; then
      jq -n --argjson schema "$USB_SCHEMA" \
        '{ schema: $schema, devices: [],
           errors: [{ code: "adb_missing", message: "找不到 adb" }] }'
      return 0
    fi
    err "找不到 adb"; hint "brew install --cask android-platform-tools"; exit 1
  fi
  [ "$JSON_MODE" -eq 1 ] && ! command -v jq >/dev/null 2>&1 && {
    err "找不到 jq（--json 需要它）"; hint "brew install jq"; exit 1; }
  migrate_legacy

  local rows="" ser st model dser prof ssid wip
  # fd 3：迴圈體裡的 adb 會把 stdin 吸乾，第二支之後就會憑空消失（踩過）
  while read -r ser st <&3; do
    [ -n "$ser" ] || continue
    model=""; dser=""; ssid=""; wip=""
    # 機型與 ro.serialno 只有 device 狀態問得到。unauthorized／offline 問不到，
    # 但 adb 的 USB serial 本來就是硬體序號，拿它當 device_serial 仍然對得起
    # merge —— 而「問不到」正是那一格最該被看見的時候，不能因此讓它消失。
    if [ "$st" = "device" ]; then
      model="$(run_timeout 8 adb -s "$ser" shell getprop ro.product.model 2>/dev/null | tr -d '\r\n')"
      dser="$(run_timeout 8 adb -s "$ser" shell getprop ro.serialno 2>/dev/null | tr -d '\r\n')"
      adb_wifi_net "$ser" && { ssid="$DEV_WIFI_SSID"; wip="$DEV_WIFI_IP"; }
    fi
    [ -n "$dser" ] || dser="$ser"
    prof="$(profile_for_serial "$dser")" || prof=""
    # SSID 裡可能有 |，換掉免得拆欄位時錯位（只影響顯示）
    rows="${rows}${ser}|${st}|${model}|${dser}|${prof}|${wip}|${ssid//|/／}"$'\n'
  done 3< <(usb_devices)

  if [ "$JSON_MODE" -eq 1 ]; then
    local objs=""
    while IFS='|' read -r ser st model dser prof wip ssid; do
      [ -n "$ser" ] || continue
      objs="${objs}$(jq -n --arg ser "$ser" --arg st "$st" --arg model "$model" \
        --arg dser "$dser" --arg prof "$prof" --arg wip "$wip" --arg ssid "$ssid" '
        def s: if . == "" then null else . end;
        { adb_serial:    $ser,
          adb_state:     $st,
          device_serial: ($dser | s),
          model:         ($model | s),
          profile:       ($prof | s),
          wifi_ssid:     ($ssid | s),
          wifi_ip:       ($wip | s) }')"$'\n'
    done <<< "$rows"
    printf '%s' "$objs" | jq -s --argjson schema "$USB_SCHEMA" \
      '{ schema: $schema, devices: ., errors: [] }'
    return 0
  fi

  local total
  total="$(printf '%s' "$rows" | grep -c . || true)"
  if [ "${total:-0}" -eq 0 ]; then
    info "這台電腦上沒有 USB 接著的 Android 裝置"
    return 0
  fi
  printf '\n  %s %s %s %s %s\n' \
    "$(pad '序號' 20)" "$(pad '狀態' 14)" "$(pad '身分' 12)" "$(pad '機型' 16)" "Wi-Fi"
  printf '  %s\n' "──────────────────────────────────────────────────────────────────────────────"
  local unauth=0 s_col s_txt w_txt
  while IFS='|' read -r ser st model dser prof wip ssid; do
    [ -n "$ser" ] || continue
    case "$st" in
      device)       s_col="$C_GRN"; s_txt="已授權" ;;
      unauthorized) s_col="$C_RED"; s_txt="未授權"; unauth=1 ;;
      *)            s_col="$C_YEL"; s_txt="$st" ;;
    esac
    w_txt="${ssid:--}"; [ -n "$wip" ] && w_txt="${w_txt}  ${wip}"
    printf '  %s %s%s%s %s %s %s\n' \
      "$(pad "$dser" 20)" "$s_col" "$(pad "$s_txt" 14)" "$C_0" \
      "$(pad "${prof:--}" 12)" "$(pad "${model:-?}" 16)" "$w_txt"
  done <<< "$rows"
  echo
  if [ "$unauth" -eq 1 ]; then
    warn "有未授權的裝置：請到那支手機上按「一律允許透過這台電腦」"
  fi
  printf '  %s插著 USB 不等於牆上看得見 —— 那要 hangar setup 把 %s 打開%s\n\n' \
    "$C_DIM" "$ADB_PORT" "$C_0"
}

# hangar scan — 列出這個網段上看得到的裝置
#
# 這是 hub 裝置牆的資料來源：它不管手機有沒有設定過、有沒有開偵錯，只回答
# 「區網上有這些東西」。已經設定過的會標出 profile 名稱，方便對照。
cmd_scan() {
  local want="" do_sweep=1 do_probe=1 do_fix=0
  JSON_MODE=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)      JSON_MODE=1; shift ;;
      # 可以給好幾次：不在這台電腦網段上的那些會改成逐台探埠（見 scan_run）
      --subnet)    [ -n "${2:-}" ] || die "--subnet 要接網段，例如 --subnet 192.168.1"
                   want="${want}${2} "
                   shift 2 ;;
      --subnet=*)  want="${want}${1#--subnet=} "; shift ;;
      --no-ping)   do_sweep=0; shift ;;
      --no-probe)  do_probe=0; shift ;;
      --fix-ip)    do_fix=1; shift ;;
      *) die "scan 不認得參數：$1" ;;
    esac
  done

  # scan 刻意不走 require_deps：它不需要 adb 也不需要 scrcpy。hub 之後會跑在一台
  # 只有網路工具的常駐機器上，在那裡因為沒裝 scrcpy 而掃不了區網是說不過去的。
  if [ "$JSON_MODE" -eq 1 ] && ! command -v jq >/dev/null 2>&1; then
    err "找不到 jq（--json 需要它）"; hint "brew install jq"; exit 1
  fi
  migrate_legacy

  if [ "$JSON_MODE" -eq 0 ]; then
    if [ "$do_sweep" -eq 1 ]; then
      info "掃描區網（先 ping 一輪把 ARP 表填起來，約 5 秒）…"
    else
      info "只讀 ARP 表（沒有 ping sweep，看得到的是最近有往來的裝置）…"
    fi
  fi

  scan_run "$want" "$do_sweep" "$do_probe"
  local rc=$?
  [ "$do_fix" -eq 1 ] && scan_fix_stale_ips

  if [ "$JSON_MODE" -eq 1 ]; then
    local errs objs="" ip mac vendor rnd adb agent agent_enrolled m prof kind dser stale fixed
    local mrec mser mmodel aby
    errs="$(printf '%s' "$SCAN_ERRORS" | jq -R -s -c \
      '[split("\n")[] | select(length > 0) | split("|")
        | { code: .[0], message: (.[1:] | join("|")) }]')"
    while IFS='|' read -r ip mac vendor rnd adb agent agent_enrolled; do
      [ -n "$ip" ] || continue
      m="$(scan_match_for_ip "$ip")" || m=""
      prof="${m%%|*}"; kind="${m##*|}"; dser=""; stale=0; fixed=0
      if [ -n "$prof" ]; then
        # hub 要的主鍵是序號，不是 IP 也不是 MAC。掃描自己拿不到，但 profile
        # 裡有 —— 對上了就一起附出去，hub 才能把 scan 與 list 兩份資料合起來。
        dser="$(profile_field "$prof" DEVICE_SERIAL)" || dser=""
        case $'\n'"$SCAN_STALE" in *$'\n'"${prof}|"*) stale=1 ;; esac
        case $'\n'"$SCAN_FIXED" in *$'\n'"${prof}|"*) fixed=1 ;; esac
      fi
      # mDNS 的 TXT 直接給得出序號與機型。這是 M3b 真正的價值：這台電腦上沒有
      # profile 的手機（例如別台電腦設定的）也拿得到主鍵，hub 才合得起來。
      mser=""; mmodel=""; aby=""
      if mrec="$(scan_mdns_for "$ip")"; then
        mser="${mrec%%|*}"; mmodel="${mrec#*|}"; aby="mdns"
        [ -n "$dser" ] || dser="$mser"
      elif [ -n "$agent" ]; then
        aby="probe"
      fi
      objs="${objs}$(jq -n \
        --arg ip "$ip" --arg mac "$mac" --arg vendor "$vendor" \
        --argjson rnd "$rnd" --arg adb "$adb" --arg prof "$prof" \
        --arg kind "$kind" --arg dser "$dser" --argjson stale "$stale" \
        --argjson fixed "$fixed" --arg agent "$agent" \
        --argjson routed "$(scan_ip_is_routed "$ip" && echo true || echo false)" \
        --arg agent_enrolled "$agent_enrolled" \
        --arg mmodel "$mmodel" --arg aby "$aby" \
        --argjson isgw "$( [ -n "$SCAN_GATEWAY" ] && [ "$ip" = "$SCAN_GATEWAY" ] && echo 1 || echo 0 )" '
        def s: if . == "" then null else . end;
        { ip:               $ip,
          mac:              ($mac | s),
          vendor:           ($vendor | s),
          mac_randomized:   ($rnd == 1),
          adb_port:         $adb,
          profile:          ($prof | s),
          matched_by:       ($kind | s),
          device_serial:    ($dser | s),
          profile_ip_stale: ($stale == 1),
          profile_ip_fixed: ($fixed == 1),
          # 有沒有 agent 住在這台機器裡。--no-probe 時一律 null（沒去問）。
          # discovered_by 說的是怎麼發現它的：mdns（agent 自己報名）或 probe
          # （逐台探 5599）。model 只有 mDNS 那條路給得出來。
          agent:            (if $agent == "" then null
                             else { version: (if $agent == "?" then null
                                              else $agent end),
                                    enrolled: (if $agent_enrolled == "" then null
                                               else $agent_enrolled == "true" end),
                                    model:        ($mmodel | s),
                                    discovered_by: ($aby | s) } end),
          # 這個網段的閘道器。標出來是因為它每次都會出現，而且絕對不是測試機
          is_gateway:       ($isgw == 1),
          # 跨網段逐台探埠找到的：沒有 MAC、只因為 5555 或 5599 有回應才列出來
          routed:           $routed }')"$'\n'
    done <<< "$SCAN_HOSTS"
    printf '%s' "$objs" | jq -s \
      --argjson schema "$SCAN_SCHEMA" \
      --arg     subnet "$( [ -n "$SCAN_SUBNET" ] && printf '%s.0/24' "$SCAN_SUBNET" )" \
      --argjson errors "$errs" \
      --arg     subnets "$SCAN_SUBNETS" \
      --arg     routed  "$SCAN_ROUTED" \
      '{ schema: $schema,
         subnet: (if $subnet == "" then null else $subnet end),
         # 全部掃了哪些 /24；subnet 是其中第一個（只有一個網段時兩者一樣）
         subnets: [$subnets | split(" ")[] | select(length > 0)
                   | { cidr: (. + ".0/24"),
                       routed: (. as $s | $routed | split(" ") | any(.[]; . == $s)) }],
         hosts:  .,
         errors: $errors }'
    return 0
  fi

  if [ "$rc" -ne 0 ]; then
    local code msg
    while IFS='|' read -r code msg; do
      [ -n "$code" ] || continue
      err "$msg"
    done <<< "$SCAN_ERRORS"
    exit 1
  fi

  local total rnd_any=0 open_n=0 anon_n=0
  total="$(printf '%s' "$SCAN_HOSTS" | grep -c . || true)"
  if [ "${total:-0}" -eq 0 ]; then
    warn "這個網段（$(printf '%s' "$SCAN_SUBNETS" | sed -E 's/([0-9]+) /\1.0\/24 /g; s/ $//; s/ /、/g')）上沒看到其他裝置"
    [ -n "$SCAN_ROUTED" ] && hint "跨網段只列得出 ${ADB_PORT} 或 ${AGENT_PORT_DEFAULT} 有回應的；兩個都沒開的手機在這裡看不到"
    [ "$do_sweep" -eq 1 ] || hint "加上 ping sweep 會看到更多：hangar scan"
    return 0
  fi

  # 廠商放最後一欄：OUI 資料庫裡的名稱長短差很多（「Hon Hai Precision Ind. Co.,
  # Ltd.」這種），擺在中間會把後面的欄位推歪。長度不固定的東西就放尾巴。
  printf '\n  %s %s %s %s %s %s\n' \
    "$(pad "IP" 17)" "$(pad "MAC" 19)" "$(pad "adb" 8)" \
    "$(pad "agent" 7)" "$(pad "身分" 12)" "廠商"
  printf '  %s\n' "$(printf '─%.0s' $(seq 1 68))"

  local ip mac vendor rnd adb agent agent_enrolled prof v_txt v_col a_txt a_col p_txt g_txt g_col
  local agent_n=0
  while IFS='|' read -r ip mac vendor rnd adb agent agent_enrolled; do
    [ -n "$ip" ] || continue

    # 跨網段探到的沒有 MAC 可以給，MAC 那一欄改標它是怎麼來的
    if scan_ip_is_routed "$ip"; then
      mac="（跨網段）"; v_txt="-"; v_col="$C_DIM"
    elif [ "$rnd" -eq 1 ]; then
      v_txt="隨機 MAC"; v_col="$C_YEL"; rnd_any=1
    elif [ -n "$vendor" ]; then
      v_txt="$vendor"; v_col=""
    else
      v_txt="?"; v_col="$C_DIM"
    fi

    case "$adb" in
      open)   a_txt="open";   a_col="$C_GRN"; open_n=$(( open_n + 1 )) ;;
      closed) a_txt="closed"; a_col="$C_DIM" ;;
      *)      a_txt="?";      a_col="$C_DIM" ;;
    esac

    if [ -n "$agent" ]; then
      g_txt="有"; g_col="$C_GRN"; agent_n=$(( agent_n + 1 ))
    else
      g_txt="-";  g_col="$C_DIM"
    fi

    # 「身分」欄回答的是「這台對我們來說是什麼」：已設定的手機叫什麼名字、
    # 是不是這個網段的閘道器、還是完全不認識。閘道器每次掃描都會出現，
    # 不標的話每個人都要重新想一次「172.20.10.1 是什麼」。
    prof="$(scan_match_for_ip "$ip")" || prof=""
    prof="${prof%%|*}"
    if [ -n "$prof" ]; then p_txt="$prof"
    elif [ -n "$SCAN_GATEWAY" ] && [ "$ip" = "$SCAN_GATEWAY" ]; then p_txt="閘道器"
    else
      p_txt="-"
      # 認不出是什麼的那幾台：沒 profile、不是閘道器、5555 關著、也沒有 agent。
      # 一支還沒 setup 的 Android 長的就是這個樣子 —— 跟智慧插座一模一樣。
      [ "$adb" != "open" ] && [ -z "$agent" ] && anon_n=$(( anon_n + 1 ))
    fi

    # 顏色碼放在補齊過的內容外面，才不會被算進欄寬
    printf '  %s %s %s%s%s %s%s%s %s %s%s%s\n' \
      "$(pad "$ip" 17)" "$(pad "$mac" 19)" \
      "$a_col" "$(pad "$a_txt" 8)" "$C_0" \
      "$g_col" "$(pad "$g_txt" 7)" "$C_0" \
      "$(pad "$p_txt" 12)" \
      "$v_col" "$v_txt" "$C_0"
  done <<< "$SCAN_HOSTS"

  echo
  printf '  %s共 %s 台，其中 %s 台的 %s 是開著的（可以 adb 進去）%s\n' \
    "$C_DIM" "$total" "$open_n" "$ADB_PORT" "$C_0"
  if [ "$agent_n" -gt 0 ]; then
    printf '  %s其中 %s 台裝了 agent，那幾台不開偵錯也看得到機型與電量%s\n' \
      "$C_DIM" "$agent_n" "$C_0"
    # mDNS 找到的那幾台連序號都有（TXT 裡帶著），不用對上 profile 就認得出是誰
    local mdns_n; mdns_n="$(printf '%s' "$SCAN_MDNS" | grep -c . || true)"
    if [ "${mdns_n:-0}" -gt 0 ]; then
      printf '  %s其中 %s 台是 agent 自己用 mDNS 報名的（連序號都有，不用對 profile）%s\n' \
        "$C_DIM" "$mdns_n" "$C_0"
    fi
  else
    printf '  %s沒開偵錯的裝置只看得到 IP / MAC —— 機型與電量要等手機端 agent app%s\n' \
      "$C_DIM" "$C_0"
  fi
  # 「掃不到我的手機」這個提問就算多了 USB 這個來源也還是會出現 —— 手機不在
  # 同一個 Wi-Fi、或 USB 插在別人電腦上的時候，它本來就該是匿名的。與其多一個
  # 欄位，不如在看到匿名那幾台時直接把話講完：**開了偵錯也一樣看不出來**。
  if [ "$anon_n" -gt 0 ]; then
    printf '  %s其中 %s 台認不出是什麼：可能是一支還沒 hangar setup 的 Android ——%s\n' \
      "$C_DIM" "$anon_n" "$C_0"
    printf '  %s  偵錯開得再正確，%s 沒打開在這裡就是匿名的（那是 setup 做的事）%s\n' \
      "$C_DIM" "$ADB_PORT" "$C_0"
  fi
  if [ "$rnd_any" -eq 1 ]; then
    printf '  %s隨機 MAC 的裝置不能只靠 MAC 認人：使用者「忘記網路」再連就會換一組%s\n' \
      "$C_DIM" "$C_0"
  fi
  local n mac oldip newip
  while IFS='|' read -r n mac; do
    [ -n "$n" ] || continue
    printf '  %s記住了「%s」的 MAC（%s）—— 之後這支手機換 IP 也認得出來%s\n' \
      "$C_DIM" "$n" "$mac" "$C_0"
  done <<< "$SCAN_LEARNED"
  scan_oui_db >/dev/null || printf '  %s廠商查不到是因為這台機器上沒有 OUI 資料庫（裝 nmap 或 arp-scan 就有）%s\n' \
    "$C_DIM" "$C_0"
  if [ "$do_probe" -eq 1 ] && [ -z "$SCAN_MDNS_TOOL" ]; then
    printf '  %s這台機器沒有 dns-sd 或 avahi-browse，所以是逐台探 %s 找 agent —— 慢一點而已%s\n' \
      "$C_DIM" "$AGENT_PORT_DEFAULT" "$C_0"
  fi
  echo

  # 認得出是同一支手機，但 profile 指著舊位址 —— 投影還是會連到錯的地方，
  # 所以這件事要用 warn 講，不能混在上面那堆灰字裡。
  local oldip newip
  while IFS='|' read -r n oldip newip; do
    [ -n "$n" ] || continue
    ok "「${n}」的 PHONE_IP 已更新：${oldip} → ${newip}"
  done <<< "$SCAN_FIXED"
  [ -n "$SCAN_FIXED" ] && echo
  while IFS='|' read -r n oldip newip; do
    [ -n "$n" ] || continue
    warn "「${n}」就是 ${newip} 這台（MAC 一樣），但 profile 還指著 ${oldip}"
    hint "hangar scan --fix-ip 直接改掉，或在路由器上把這支手機綁固定 IP"
    echo
  done <<< "$SCAN_STALE"
}

# --------------------------------------------------------- agent-tokens -----
#
# hub 驗 agent 主動回報（POST /api/checkin）用的那張表：序號 → token。
#
# 為什麼是一個獨立的指令、而不是塞進 list --json：list 那一份會被 hub 整包端到
# 網頁上，token 不能在裡面。這一份只給同一台、同一個使用者的 hub 讀 —— 它能
# 讀這份輸出，本來就能直接讀 profile 檔，沒有擴大誰看得到什麼。
cmd_agent_tokens() {
  local json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      *) die "agent-tokens 不認得參數：$1" ;;
    esac
  done
  [ "$json" -eq 1 ] || die "agent-tokens 只給程式讀：hangar agent-tokens --json"
  command -v jq >/dev/null 2>&1 || { err "找不到 jq（--json 需要它）"; exit 1; }
  migrate_legacy
  local n ser tok objs=""
  while IFS= read -r n <&3; do
    [ -n "$n" ] || continue
    ser="$(profile_field "$n" DEVICE_SERIAL)" || ser=""
    tok="$(profile_field "$n" AGENT_TOKEN)" || tok=""
    [ -n "$ser" ] && [ -n "$tok" ] || continue
    objs="${objs}$(jq -nc --arg p "$n" --arg s "$ser" --arg t "$tok" \
      '{profile: $p, device_serial: $s, token: $t}')"$'\n'
  done 3< <(list_profiles)
  printf '%s' "$objs" | jq -s '{schema: 1, tokens: .}'
}

# ----------------------------------------------------------------- main -----

main() {
  local cmd="${1:-}"
  case "$cmd" in
    setup)           shift; cmd_setup "$@" ;;
    status|st)       shift; cmd_status "$@" ;;
    reset)           shift; cmd_reset "$@" ;;
    list|ls)         shift; cmd_list "$@" ;;
    scan)            shift; cmd_scan "$@" ;;
    usb)             shift; cmd_usb "$@" ;;
    enroll)          shift; cmd_enroll "$@" ;;
    ring)            shift; cmd_ring "$@" ;;
    adb|debug)       shift; cmd_adb "$@" ;;
    use)             shift; cmd_use "${1:-}" ;;
    forget|rm)       shift; cmd_forget "${1:-}" ;;
    all)             shift; cmd_all "$@" ;;
    wall)            shift; cmd_wall "$@" ;;
    agent-tokens)    shift; cmd_agent_tokens "$@" ;;
    help|-h|--help)  cmd_help ;;
    --version|-V)    printf 'hangar %s\n' "$VERSION" ;;
    ""|-*)           cmd_mirror "$@" ;;
    *)               err "未知指令：$cmd"; echo; cmd_help; exit 1 ;;
  esac
}

main "$@"
