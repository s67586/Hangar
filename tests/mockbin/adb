#!/usr/bin/env bash
S="$MOCK_STATE"
DEV="$S/adb_devices"

# 模擬 adb server 掛掉：daemon_down 檔內的數字代表「接下來幾次呼叫會噴 daemon 錯誤」
daemon_check() {
  local n; n="$(cat "$S/daemon_down" 2>/dev/null || echo 0)"
  [ "${n:-0}" -gt 0 ] || return 0
  echo $(( n - 1 )) > "$S/daemon_down"
  echo "* daemon still not running"
  echo "error: cannot connect to daemon at tcp:5037: Connection refused"
  exit 1
}

case "$1" in
  start-server)
    echo "start-server" >> "$S/connect_log"
    # daemon_permanent 存在時，start-server 也救不回來（模擬本機 adb 環境壞掉）
    [ -f "$S/daemon_permanent" ] || echo 0 > "$S/daemon_down"
    exit 0
    ;;
esac

case "$1" in
  devices)
    echo "List of devices attached"
    cat "$DEV" 2>/dev/null
    ;;
  connect)
    echo "connect $2" >> "$S/connect_log"
    daemon_check
    case "$(cat "$S/adb_connect_result" 2>/dev/null)" in
      fail)   echo "failed to connect to '$2': Connection refused"; exit 1 ;;
      silent) exit 1 ;;   # 模擬被 timeout 砍掉：完全沒有輸出
      unauthorized)
        grep -qE "^$2[[:space:]]" "$DEV" 2>/dev/null || printf '%s\tunauthorized\n' "$2" >> "$DEV"
        echo "connected to $2"; exit 0 ;;
    esac
    grep -qE "^$2[[:space:]]" "$DEV" 2>/dev/null || printf '%s\tdevice\n' "$2" >> "$DEV"
    # 既有的 offline/unauthorized 項目轉成 device
    awk -v s="$2" 'BEGIN{OFS="\t"} $1==s{$2="device"} {print $1,$2}' "$DEV" > "$DEV.tmp" 2>/dev/null && mv "$DEV.tmp" "$DEV"
    echo "connected to $2"
    ;;
  disconnect)
    echo "disconnect $2" >> "$S/connect_log"
    grep -vE "^$2[[:space:]]" "$DEV" > "$DEV.tmp" 2>/dev/null; mv "$DEV.tmp" "$DEV" 2>/dev/null
    echo "disconnected $2"
    ;;
  pair) echo "Successfully paired to $2 [guid=adb-mock]" ;;
  -s)
    ser="$2"; shift 2
    case "$1" in
      tcpip) echo "restarting in TCP mode port: $2"; echo "tcpip $2" >> "$S/connect_log" ;;
      install)
        # 最後一個參數是 APK 路徑
        for a in "$@"; do apk="$a"; done
        echo "$ser install $apk" >> "$S/adb_log"
        if [ -f "$S/install_fail" ]; then echo "adb: failed to install $apk"; exit 1; fi
        echo "Performing Streamed Install"; echo "Success"
        ;;
      shell)
        case "$2" in
          pm)
            echo "pm $*" >> "$S/adb_log"
            # grant_fail 存在時模擬「這個權限拿不到」
            [ -f "$S/grant_fail" ] && { echo "Operation not allowed: java.lang.SecurityException"; exit 0; }
            exit 0 ;;
          am)
            echo "am $*" >> "$S/adb_log"
            # 入伍廣播：把 token 寫下來，假 agent 之後就認這一組
            tok=""; ser_in=""; name_in=""
            prev=""
            for a in "$@"; do
              case "$prev" in
                token) tok="$a" ;;
                serial) ser_in="$a" ;;
                name) name_in="$a" ;;
              esac
              prev=""
              case "$a" in token) prev=token ;; serial) prev=serial ;; name) prev=name ;; esac
            done
            if [ -f "$S/enroll_already" ]; then
              echo 'Broadcast completed: result=1, data="already_enrolled"'; exit 0
            fi
            [ -n "$tok" ] && printf '%s' "$tok" > "$S/agent_token"
            [ -n "$ser_in" ] && printf '%s' "$ser_in" > "$S/agent_serial"
            [ -n "$name_in" ] && printf '%s' "$name_in" > "$S/agent_name"
            echo 'Broadcast completed: result=0, data="enrolled"'
            exit 0 ;;
        esac
        case "$ser" in
          *110:5555) m="Zenfone 10"; sn="ZEN0000002"; mac="f0:5c:77:aa:bb:02" ;;
          *) m="Pixel 7 Pro"; sn="PIX0000001"; mac="f0:5c:77:aa:bb:01" ;;
        esac
        # MAC 可由 state 檔換掉：wifi_mac（測隨機 MAC）、wifi_off（測沒連 Wi-Fi）
        [ -f "$S/wifi_mac" ] && mac="$(cat "$S/wifi_mac")"
        case "$2" in
          dumpsys)
            [ "$3" = "battery" ] || exit 0
            # 電量可由 state 檔控制：battery_level / battery_status（預設 78%、放電中）
            lvl="$(cat "$S/battery_level" 2>/dev/null || echo 78)"
            stt="$(cat "$S/battery_status" 2>/dev/null || echo 3)"
            cat <<BATT
Current Battery Service state:
  AC powered: false
  USB powered: true
  status: $stt
  health: 2
  present: true
  level: $lvl
  scale: 100
  voltage: 4201
  temperature: 275
  technology: Li-ion
BATT
            ;;
          cmd)
            [ "$3" = "wifi" ] && [ "$4" = "status" ] || exit 0
            if [ -f "$S/wifi_off" ]; then echo "Wifi is disabled"; exit 0; fi
            echo "Wifi is enabled"
            echo "Wifi is connected to \"TestNet\""
            echo "WifiInfo: SSID: \"TestNet\", BSSID: e8:26:89:1a:a3:d1, MAC: $mac, IP: /192.168.1.5, Security type: 0"
            ;;
          getprop)
            case "$3" in
              ro.product.model) echo "$m" ;;
              ro.build.version.release) echo "14" ;;
              ro.build.version.sdk) echo "34" ;;
              ro.serialno) echo "$sn" ;;
            esac ;;
        esac ;;
    esac
    ;;
esac
