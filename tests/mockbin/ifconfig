#!/usr/bin/env bash
#
# 假的 ifconfig（macOS 那條路）。netmask 照 macOS 的寫法印成 0xffffff00。
#
#   ifconfig -l         → 介面清單
#   ifconfig <介面>     → 那個介面的內容
#
# utun4 故意用**點對點**的格式（inet A --> B netmask …）：真實世界裡跑 Tailscale
# 的機器預設路由就是這種介面，而照欄位位置抓 netmask 會抓到對端位址。
S="$MOCK_STATE"
echo "ifconfig $*" >> "$S/ifconfig_log"
[ -f "$S/ifconfig_out" ] && { cat "$S/ifconfig_out"; exit 0; }

if [ "${1:-}" = "-l" ]; then
  cat "$S/ifconfig_list" 2>/dev/null || echo "lo0 en0"
  exit 0
fi

case "${1:-en0}" in
  utun*)
    cat <<OUT
$1: flags=8051<UP,POINTOPOINT,RUNNING,MULTICAST> mtu 1280
	inet 100.104.114.122 --> 100.104.114.122 netmask 0xffffffff
OUT
    ;;
  lo0)
    cat <<OUT
lo0: flags=8049<UP,LOOPBACK,RUNNING,MULTICAST> mtu 16384
	inet 127.0.0.1 netmask 0xff000000
OUT
    ;;
  *)
    cat <<OUT
$1: flags=8863<UP,BROADCAST,SMART,RUNNING,SIMPLEX,MULTICAST> mtu 1500
	inet 192.168.1.42 netmask 0xffffff00 broadcast 192.168.1.255
OUT
    ;;
esac
