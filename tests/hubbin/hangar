#!/usr/bin/env bash
#
# 假的 hangar，給 test_hub.sh 用。
# 它不看真實世界，只把 $MOCK_STATE 裡準備好的 JSON 吐出來，並把每次被呼叫的
# 參數記進 argv_log —— hub 有沒有偷偷帶 --fix-ip 就是靠那份紀錄檢查的。
#
printf '%s\n' "$*" >> "$MOCK_STATE/argv_log"

case "$1" in
  list)
    [ -f "$MOCK_STATE/list_fail" ] && { echo "假裝壞掉了" >&2; exit 1; }
    # 真實世界裡外部程式的輸出不保證是乾淨的 UTF-8，這裡要模擬得出來
    [ -f "$MOCK_STATE/list_stderr" ] && cat "$MOCK_STATE/list_stderr" >&2
    cat "$MOCK_STATE/list_json"
    ;;
  scan)
    [ -f "$MOCK_STATE/scan_fail" ] && { echo "掃不動" >&2; exit 1; }
    cat "$MOCK_STATE/scan_json"
    ;;
  usb)
    [ -f "$MOCK_STATE/usb_fail" ] && { echo "問不到 adb" >&2; exit 1; }
    # 沒準備檔案就當「沒有插任何東西」—— 大部分測試不關心這一份
    if [ -f "$MOCK_STATE/usb_json" ]; then cat "$MOCK_STATE/usb_json"
    else echo '{"schema":1,"devices":[],"errors":[]}'; fi
    ;;
  agent-tokens)
    # hub 驗主動回報用的 token 表。沒準備就是空的
    if [ -f "$MOCK_STATE/tokens_json" ]; then cat "$MOCK_STATE/tokens_json"
    else echo '{"schema":1,"tokens":[]}'; fi
    ;;
  *) echo "假 hangar 不認得：$1" >&2; exit 2 ;;
esac
